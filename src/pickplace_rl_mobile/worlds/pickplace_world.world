<?xml version="1.0"?>
<sdf version="1.7">
  <world name="pickplace_world">
    
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>0</real_time_update_rate>
    </physics>

    <!-- Lighting -->
    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun
      </uri>
    </include>

    <!-- Ground plane -->
    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane
      </uri>
    </include>

    <!-- Object Bin (collection zone) -->
    <model name="object_bin">
      <static>true</static>
      <pose>0.6 0 0 0 0 0</pose>
      
      <!-- Base (0.38 x 0.38, height unchanged) -->
      <link name="base">
        <visual name="base_visual">
          <geometry>
            <box><size>0.38 0.38 0.05</size></box>
          </geometry>
          <material>
            <ambient>0.5 0.3 0.1 1</ambient>
            <diffuse>0.5 0.3 0.1 1</diffuse>
          </material>
        </visual>
        <collision name="base_collision">
          <geometry>
            <box><size>0.38 0.38 0.05</size></box>
          </geometry>
        </collision>
      </link>

      <!-- Front Wall -->
      <link name="front_wall">
        <pose>0 0.19 0.05 0 0 0</pose>
        <visual name="front_visual">
          <geometry>
            <box><size>0.38 0.01 0.05</size></box>
          </geometry>
          <material>
            <ambient>0.5 0.3 0.1 1</ambient>
            <diffuse>0.5 0.3 0.1 1</diffuse>
          </material>
        </visual>
        <collision name="front_collision">
          <geometry>
            <box><size>0.38 0.01 0.05</size></box>
          </geometry>
        </collision>
      </link>

      <!-- Back Wall -->
      <link name="back_wall">
        <pose>0 -0.19 0.05 0 0 0</pose>
        <visual name="back_visual">
          <geometry>
            <box><size>0.38 0.01 0.05</size></box>
          </geometry>
          <material>
            <ambient>0.5 0.3 0.1 1</ambient>
            <diffuse>0.5 0.3 0.1 1</diffuse>
          </material>
        </visual>
        <collision name="back_collision">
          <geometry>
            <box><size>0.38 0.01 0.05</size></box>
          </geometry>
        </collision>
      </link>

      <!-- Left Wall -->
      <link name="left_wall">
        <pose>-0.19 0 0.05 0 0 0</pose>
        <visual name="left_visual">
          <geometry>
            <box><size>0.01 0.38 0.05</size></box>
          </geometry>
          <material>
            <ambient>0.5 0.3 0.1 1</ambient>
            <diffuse>0.5 0.3 0.1 1</diffuse>
          </material>
        </visual>
        <collision name="left_collision">
          <geometry>
            <box><size>0.01 0.38 0.05</size></box>
          </geometry>
        </collision>
      </link>

      <!-- Right Wall -->
      <link name="right_wall">
        <pose>0.19 0 0.05 0 0 0</pose>
        <visual name="right_visual">
          <geometry>
            <box><size>0.01 0.38 0.05</size></box>
          </geometry>
          <material>
            <ambient>0.5 0.3 0.1 1</ambient>
            <diffuse>0.5 0.3 0.1 1</diffuse>
          </material>
        </visual>
        <collision name="right_collision">
          <geometry>
            <box><size>0.01 0.38 0.05</size></box>
          </geometry>
        </collision>
      </link>

      <!-- Joints to connect walls to base -->
      <joint name="base_to_front" type="fixed">
        <parent>base</parent>
        <child>front_wall</child>
      </joint>
      <joint name="base_to_back" type="fixed">
        <parent>base</parent>
        <child>back_wall</child>
      </joint>
      <joint name="base_to_left" type="fixed">
        <parent>base</parent>
        <child>left_wall</child>
      </joint>
      <joint name="base_to_right" type="fixed">
        <parent>base</parent>
        <child>right_wall</child>
      </joint>
    </model>

    <!-- Target Zone (placement area) -->
    <model name="target_zone">
      <static>true</static>
      <pose>0.6 0.5 0.001 0 0 0</pose>
      <link name="marker">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>0.002</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 1 0 0.5</ambient>
            <diffuse>0 1 0 0.5</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Pickable Object: 8x8x8 cm box — flat faces give reliable gripper contact -->
    <model name="pickup_object">
      <pose>0.6 0 0.065 0 0 0</pose>
      <link name="link">
        <inertial>
          <!-- 500g solid cube: side=0.08m
               Ixx=Iyy=Izz = m*(a²+b²)/12 = 0.5*(0.0064+0.0064)/12 ≈ 0.000533 -->
          <mass>0.5</mass>
          <inertia>
            <ixx>0.000533</ixx>
            <iyy>0.000533</iyy>
            <izz>0.000533</izz>
          </inertia>
        </inertial>
        <velocity_decay>
          <linear>0.5</linear>
          <angular>1.0</angular>
        </velocity_decay>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.08 0.08 0.08</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.08 0.08 0.08</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.5</mu>
                <mu2>1.5</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>100000</kp>
                <kd>500</kd>
                <max_vel>0.01</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
      </link>
    </model>

    <!-- Static Camera (world-fixed, no jitter) -->
    <model name="static_camera_model">
      <static>true</static>
      <pose>0.6 0.0 0.8 0 1.5708 0</pose>
      <link name="camera_link">
        <sensor name="camera_head" type="rgbd_camera">
          <camera>
            <horizontal_fov>1.5184</horizontal_fov>
            <image>
              <width>424</width>
              <height>240</height>
            </image>
            <clip>
              <near>0.05</near>
              <far>5.0</far>
            </clip>
          </camera>
          <always_on>1</always_on>
          <gz_frame_id>camera_head_depth_optical_frame</gz_frame_id>
          <topic>camera_head</topic>
          <update_rate>5</update_rate>
          <visualize>true</visualize>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
